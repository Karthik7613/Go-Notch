# ==========================================
# WhatsApp Monitor Backend Environment Config
# ==========================================

# Port for the Node.js backend server
PORT=3000

# Supabase Credentials (optional cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Razorpay API Credentials (for real payments)
# Find in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
